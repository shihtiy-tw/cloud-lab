# cloud-lab environment template
#
# Copy to .env and fill in. `.env` is gitignored (.gitignore:44); this example is
# the only version that gets committed, so never put a real secret in here.
#
#   cp .env.example .env && $EDITOR .env
#
# scripts/cloud.*.sh load .env automatically from the repository root. To use it
# with a bare terraform/packer invocation, export it yourself:
#
#   set -a && . ./.env && set +a
#
# HOW THIS FILE IS READ: it is sourced as bash, so command substitution works.
# That is the recommended way to handle secrets -- pull them from a real secret
# store at use time instead of writing them here in plaintext:
#
#   export ARM_CLIENT_SECRET="$(op read 'op://vault/azure-sp/password')"
#   export TF_VAR_db_password="$(gcloud secrets versions access latest --secret=db)"
#
# Because it is sourced, anything in .env runs with your shell's privileges.
# Treat it like a shell script you wrote, not like inert config.
#
# NAMING: Terraform picks up TF_VAR_<name> for any input variable; Packer picks up
# PKR_VAR_<name>. So every variable in a variables.tf or variables.pkr.hcl is
# settable here without a tfvars file. Variables that already have a sensible
# default are commented out -- uncomment only to override.

# =============================================================================
# Which cloud you are working on
# =============================================================================
# cloud.switch.sh persists this to .cloud-context; setting it here makes the
# --cloud flag optional. One of: aws gcp azure oracle
# export CLOUD_PROVIDER=aws

# Applies to every stack. Both are REQUIRED by all three dev-vm stacks and have
# no default. One of: dev staging test prod
export TF_VAR_project_name=cloud-lab
export TF_VAR_environment=dev

# =============================================================================
# AWS
# =============================================================================
# Credentials: prefer a named profile or SSO over static keys. Static keys are
# supported by the provider but are the thing most likely to leak.
export AWS_PROFILE=cloud-lab
export AWS_REGION=us-east-1
# export AWS_ACCESS_KEY_ID=
# export AWS_SECRET_ACCESS_KEY=
# export AWS_SESSION_TOKEN=

# Terraform inputs (aws/compute/dev-vm). Defaults shown; uncomment to override.
# export TF_VAR_region=us-east-1
# export TF_VAR_instance_type=t3.large
# export TF_VAR_vpc_cidr=10.30.0.0/16

# The AMI built by shared/packer. There is no sane default -- an unpinned image
# lookup means the next Ubuntu release silently replaces your VM.
# export TF_VAR_ami_id=ami-xxxxxxxxxxxxxxxxx

# =============================================================================
# GCP
# =============================================================================
# project_id is REQUIRED and has no default.
export TF_VAR_project_id=my-gcp-project
export GOOGLE_APPLICATION_CREDENTIALS="${HOME}/.config/gcloud/application_default_credentials.json"
# export CLOUDSDK_CORE_PROJECT=my-gcp-project

# export TF_VAR_region=us-central1
# Empty means "<region>-a". Pick deliberately: the home disk is zonal, so the VM
# can only ever come back in the zone its disk lives in.
# export TF_VAR_zone=""
# export TF_VAR_machine_type=e2-standard-4

# The one tcp:22 ingress range. Leave this alone: it defaults to the range Google
# publishes for IAP TCP forwarding, declared once in gcp/shared/modules/network.
# Overriding it to 0.0.0.0/0 is rejected by the module's own validation, because
# that turns an IAP-brokered box into a public SSH server.
# export TF_VAR_iap_source_ranges='["35.235.240.0/20"]'

# =============================================================================
# Azure
# =============================================================================
# resource_group_name is REQUIRED and has no default.
export TF_VAR_resource_group_name=cloud-lab-dev-vm
export ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Service principal auth. Omit all four to fall back on `az login`, which is the
# better choice for a laptop.
# export ARM_TENANT_ID=
# export ARM_CLIENT_ID=
# export ARM_CLIENT_SECRET=

# export TF_VAR_location=eastus
# export TF_VAR_vm_size=Standard_D2s_v5

# Bastion SKU. Developer is free and browser-only. Basic costs ~$140/mo and is
# STILL browser-only -- only Standard accepts tunneling_enabled for the native
# `az network bastion ssh` client.
# export TF_VAR_bastion_sku=Developer

# =============================================================================
# Oracle (no Terraform yet -- placeholder)
# =============================================================================
# export TF_VAR_compartment_ocid=
# export OCI_CLI_PROFILE=DEFAULT

# =============================================================================
# Packer (shared/packer) -- PKR_VAR_ prefix
# =============================================================================
# Pin the dotfiles ref to a commit SHA for a reproducible image. The default,
# `develop`, is a moving target: the same build on two days gives two images.
# export PKR_VAR_dotfiles_ref=develop
# 24.04 not 26.04: third-party apt repos (Docker, HashiCorp, k8s) lag a new
# release, so "latest LTS" is the riskier default. Packer makes trying it cheap.
# export PKR_VAR_ubuntu_release=24.04
# export PKR_VAR_architecture=amd64
# export PKR_VAR_target_user=ubuntu
# export PKR_VAR_root_volume_size=50

# Per-cloud build inputs. Each builder needs a subnet to build in.
# export PKR_VAR_aws_subnet_id=subnet-xxxxxxxx
# export PKR_VAR_gcp_project_id=my-gcp-project
# export PKR_VAR_gcp_subnetwork=my-subnet
# export PKR_VAR_azure_subscription_id=

# Azure cannot build privately from a laptop: setting a build VNet requires
# Packer to run inside it. The build VM therefore takes a temporary public IP
# scoped to your egress /32. The DEV VM never gets one.
# export PKR_VAR_azure_build_allowed_cidr="$(curl -fsS ifconfig.me)/32"

# =============================================================================
# Terratest (only needed to run the integration suites)
# =============================================================================
# These are read directly by the Go tests, not through TF_VAR_.
# export GCP_PROJECT_ID=my-gcp-project
# export GCP_DEVELOPER_PRINCIPAL=user:me@example.com
# export DEV_VM_IMAGE_ID=ami-xxxxxxxxxxxxxxxxx
# export DEV_VM_SSH_PUBLIC_KEY="${HOME}/.ssh/id_ed25519.pub"

# Leave the stack standing after a failed test run so you can inspect it.
# Billable resources keep running until you destroy them by hand.
# export SKIP_DESTROY=false

# =============================================================================
# Script behaviour
# =============================================================================
# export CLOUD_LAB_DEBUG=1   # log_debug output from scripts/lib/common.sh
# export NO_COLOR=1          # disable ANSI colour in script output
